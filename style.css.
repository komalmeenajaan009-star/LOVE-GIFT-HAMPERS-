/*====================================

LOVE GIFT HAMPERS
PREMIUM LUXURY CSS

====================================*/

*{
margin:0;
padding:0;
box-sizing:border-box;
}

html{
scroll-behavior:smooth;
}

body{

font-family:'Poppins',sans-serif;

background:#0d0d0d;

color:#ffffff;

overflow-x:hidden;

}

img{

max-width:100%;

display:block;

}

a{

text-decoration:none;

color:inherit;

}

.container{

width:min(1280px,92%);

margin:auto;

}

/*================ HEADER ================*/

.header{

position:sticky;

top:0;

z-index:999;

background:rgba(0,0,0,.82);

backdrop-filter:blur(18px);

border-bottom:1px solid rgba(255,215,0,.18);

}

.header .container{

display:flex;

align-items:center;

justify-content:space-between;

gap:25px;

padding:18px 0;

}

.brand{

display:flex;

align-items:center;

gap:15px;

}

.logo{

width:72px;

height:72px;

object-fit:cover;

border-radius:50%;

border:3px solid #d4af37;

box-shadow:0 0 18px rgba(212,175,55,.45);

}

.brand h2{

font-size:28px;

font-weight:800;

letter-spacing:1px;

color:#ffffff;

}

.brand p{

font-size:13px;

color:#d4af37;

margin-top:3px;

}

/*================ SEARCH ================*/

.search-box{

flex:1;

display:flex;

max-width:520px;

background:#171717;

border:2px solid #d4af37;

border-radius:60px;

overflow:hidden;

}

.search-box input{

flex:1;

background:transparent;

border:none;

outline:none;

padding:16px 20px;

color:#fff;

font-size:15px;

}

.search-box input::placeholder{

color:#bbbbbb;

}

.search-box button{

width:65px;

border:none;

background:#d4af37;

font-size:18px;

cursor:pointer;

transition:.3s;

}

.search-box button:hover{

background:#f6d76b;

}

/*================ HEADER ICONS ================*/

.header-icons{

display:flex;

align-items:center;

gap:18px;

}

.header-icons a{

width:50px;

height:50px;

display:flex;

align-items:center;

justify-content:center;

border-radius:50%;

background:#171717;

border:2px solid rgba(212,175,55,.35);

font-size:20px;

transition:.35s;

position:relative;

}

.header-icons a:hover{

background:#d4af37;

color:#000;

transform:translateY(-4px);

}

#cart-count{

position:absolute;

top:-6px;

right:-5px;

background:#ff2d55;

color:#fff;

width:22px;

height:22px;

border-radius:50%;

display:flex;

align-items:center;

justify-content:center;

font-size:12px;

font-weight:700;

}/*================ NAVBAR ================*/

.navbar{

background:#121212;

border-top:1px solid rgba(255,215,0,.08);

border-bottom:1px solid rgba(255,215,0,.08);

}

.navbar .container{

display:flex;

justify-content:center;

align-items:center;

gap:40px;

padding:18px 0;

flex-wrap:wrap;

}

.navbar a{

font-size:16px;

font-weight:600;

color:#ffffff;

position:relative;

transition:.35s;

}

.navbar a::after{

content:"";

position:absolute;

left:0;

bottom:-8px;

width:0;

height:2px;

background:#d4af37;

transition:.35s;

}

.navbar a:hover{

color:#d4af37;

}

.navbar a:hover::after{

width:100%;

}

/*================ HERO ================*/

.hero{

padding:90px 0;

background:

radial-gradient(circle at top right,#5a4308 0%,transparent 35%),

radial-gradient(circle at bottom left,#2c2104 0%,transparent 30%),

#0d0d0d;

}

.hero-grid{

display:grid;

grid-template-columns:1fr 1fr;

align-items:center;

gap:70px;

}

.hero-text span{

display:inline-block;

background:#d4af37;

color:#000;

padding:10px 20px;

border-radius:50px;

font-size:14px;

font-weight:700;

margin-bottom:20px;

}

.hero-text h1{

font-size:64px;

line-height:1.1;

font-weight:800;

margin-bottom:25px;

}

.hero-text p{

font-size:18px;

color:#cfcfcf;

line-height:1.8;

margin-bottom:35px;

max-width:650px;

}

.hero-btns{

display:flex;

gap:18px;

flex-wrap:wrap;

}

.btn{

display:inline-flex;

align-items:center;

justify-content:center;

padding:16px 34px;

border-radius:60px;

font-weight:700;

transition:.35s;

cursor:pointer;

}

.btn.gold{

background:#d4af37;

color:#000;

}

.btn.gold:hover{

transform:translateY(-5px);

box-shadow:0 18px 40px rgba(212,175,55,.45);

}

.btn.dark{

background:#181818;

border:2px solid #d4af37;

color:#fff;

}

.btn.dark:hover{

background:#d4af37;

color:#000;

}

.hero-image{

display:flex;

justify-content:center;

}

.hero-image img{

width:470px;

max-width:100%;

border-radius:50%;

border:5px solid #d4af37;

box-shadow:0 0 60px rgba(212,175,55,.35);

animation:float 4s ease-in-out infinite;

}

@keyframes float{

0%{

transform:translateY(0);

}

50%{

transform:translateY(-14px);

}

100%{

transform:translateY(0);

}

  }/*================ SECTION TITLE ================*/

.section-header{

text-align:center;

margin-bottom:60px;

}

.section-header h2{

font-size:44px;

font-weight:800;

color:#ffffff;

margin-bottom:15px;

}

.section-header p{

font-size:17px;

color:#bfbfbf;

max-width:700px;

margin:auto;

line-height:1.8;

}

/*================ FEATURES ================*/

.features{

padding:90px 0;

background:#101010;

}

.features .container{

display:grid;

grid-template-columns:repeat(4,1fr);

gap:30px;

}

.feature-card{

background:#171717;

padding:35px 25px;

text-align:center;

border-radius:22px;

border:1px solid rgba(212,175,55,.18);

transition:.35s;

}

.feature-card i{

font-size:42px;

color:#d4af37;

margin-bottom:18px;

}

.feature-card h3{

font-size:22px;

margin-bottom:12px;

}

.feature-card p{

color:#bfbfbf;

line-height:1.7;

}

.feature-card:hover{

transform:translateY(-10px);

border-color:#d4af37;

box-shadow:0 18px 40px rgba(212,175,55,.18);

}

/*================ CATEGORIES ================*/

.categories{

padding:90px 0;

background:#0d0d0d;

}

.category-grid{

display:grid;

grid-template-columns:repeat(3,1fr);

gap:30px;

}

.category-card{

background:#171717;

padding:40px 20px;

border-radius:24px;

text-align:center;

border:1px solid rgba(212,175,55,.15);

transition:.35s;

cursor:pointer;

}

.category-card .icon{

font-size:54px;

margin-bottom:18px;

}

.category-card h3{

font-size:24px;

font-weight:700;

}

.category-card:hover{

background:#d4af37;

color:#000;

transform:translateY(-8px) scale(1.03);

box-shadow:0 20px 45px rgba(212,175,55,.28);

                             }/*================ PRODUCTS ================*/

.products{

padding:100px 0;

background:#101010;

}

.product-grid{

display:grid;

grid-template-columns:repeat(3,1fr);

gap:35px;

}

.product-card{

background:#171717;

border-radius:24px;

overflow:hidden;

position:relative;

border:1px solid rgba(212,175,55,.15);

transition:.35s;

}

.product-card:hover{

transform:translateY(-12px);

border-color:#d4af37;

box-shadow:0 25px 50px rgba(212,175,55,.22);

}

.product-card img{

width:100%;

height:300px;

object-fit:cover;

transition:.5s;

}

.product-card:hover img{

transform:scale(1.08);

}

.badge{

position:absolute;

top:18px;

left:18px;

background:#d4af37;

color:#000;

padding:8px 16px;

border-radius:40px;

font-size:13px;

font-weight:700;

z-index:2;

}

.product-content{

padding:24px;

}

.product-content h3{

font-size:24px;

margin-bottom:12px;

font-weight:700;

}

.rating{

color:#FFD700;

font-size:17px;

margin-bottom:15px;

}

.rating span{

color:#bfbfbf;

font-size:14px;

margin-left:8px;

}

.price{

font-size:28px;

font-weight:800;

color:#d4af37;

margin-bottom:15px;

}

.price del{

font-size:18px;

color:#8f8f8f;

margin-left:10px;

font-weight:500;

}

.product-content p{

color:#c9c9c9;

line-height:1.8;

margin-bottom:22px;

min-height:58px;

}

.product-buttons{

display:flex;

flex-direction:column;

gap:12px;

}

.product-buttons button,

.product-buttons a{

display:flex;

align-items:center;

justify-content:center;

height:48px;

border-radius:12px;

font-weight:700;

font-size:15px;

transition:.35s;

cursor:pointer;

}

.btn-outline{

background:transparent;

color:#fff;

border:2px solid #d4af37;

}

.btn-outline:hover{

background:#d4af37;

color:#000;

}

.btn-cart{

background:#222;

color:#fff;

border:none;

}

.btn-cart:hover{

background:#333;

}

.btn-buy{

background:#d4af37;

color:#000;

}

.btn-buy:hover{

background:#f5d66a;

transform:translateY(-2px);

}

.load-more{

text-align:center;

margin-top:60px;

}

.more-products{

padding-bottom:100px;

background:#101010;

  }/*================ WHY US ================*/

.why-us{

padding:100px 0;

background:#0d0d0d;

}

.why-grid{

display:grid;

grid-template-columns:repeat(4,1fr);

gap:30px;

}

.why-card{

background:#171717;

padding:35px 25px;

border-radius:22px;

text-align:center;

border:1px solid rgba(212,175,55,.15);

transition:.35s;

}

.why-card i{

font-size:42px;

color:#d4af37;

margin-bottom:18px;

}

.why-card h3{

font-size:22px;

margin-bottom:12px;

}

.why-card p{

color:#c7c7c7;

line-height:1.7;

}

.why-card:hover{

transform:translateY(-10px);

border-color:#d4af37;

box-shadow:0 20px 45px rgba(212,175,55,.18);

}

/*================ REVIEWS ================*/

.reviews{

padding:100px 0;

background:#101010;

}

.review-grid{

display:grid;

grid-template-columns:repeat(3,1fr);

gap:30px;

}

.review-card{

background:#171717;

padding:35px;

border-radius:22px;

border:1px solid rgba(212,175,55,.15);

font-size:18px;

line-height:1.8;

transition:.35s;

}

.review-card h4{

margin-top:20px;

color:#d4af37;

font-size:18px;

}

.review-card:hover{

transform:translateY(-8px);

box-shadow:0 18px 40px rgba(212,175,55,.18);

}

/*================ WHATSAPP CTA ================*/

.whatsapp-section{

padding:90px 0;

text-align:center;

background:linear-gradient(135deg,#151515,#0d0d0d);

}

.whatsapp-section h2{

font-size:42px;

margin-bottom:18px;

}

.whatsapp-section p{

color:#c7c7c7;

font-size:18px;

margin-bottom:35px;

line-height:1.8;

}

/*================ FOOTER ================*/

.footer{

background:#090909;

padding:80px 0 30px;

border-top:1px solid rgba(212,175,55,.15);

}

.footer-grid{

display:grid;

grid-template-columns:2fr 1fr 1fr 1fr;

gap:40px;

margin-bottom:40px;

}

.footer-logo{

width:90px;

height:90px;

border-radius:50%;

border:3px solid #d4af37;

margin-bottom:18px;

}

.footer h3{

margin-bottom:18px;

font-size:22px;

}

.footer p,

.footer li{

color:#bfbfbf;

line-height:1.9;

list-style:none;

}

.footer ul{

padding:0;

}

.footer a{

transition:.3s;

}

.footer a:hover{

color:#d4af37;

}

.social-icons{

display:flex;

gap:15px;

margin-top:15px;

}

.social-icons a{

width:46px;

height:46px;

display:flex;

align-items:center;

justify-content:center;

background:#171717;

border-radius:50%;

border:1px solid rgba(212,175,55,.2);

font-size:18px;

transition:.35s;

}

.social-icons a:hover{

background:#d4af37;

color:#000;

transform:translateY(-4px);

}

.footer hr{

border:none;

border-top:1px solid rgba(255,255,255,.08);

margin:35px 0;

}

.copyright{

display:flex;

justify-content:space-between;

align-items:center;

flex-wrap:wrap;

gap:15px;

color:#9f9f9f;

font-size:14px;

}

/*================ SCROLL TOP ================*/

#scrollTop{

position:fixed;

right:25px;

bottom:25px;

width:52px;

height:52px;

border:none;

border-radius:50%;

background:#d4af37;

color:#000;

font-size:20px;

cursor:pointer;

box-shadow:0 10px 25px rgba(212,175,55,.35);

transition:.35s;

}

#scrollTop:hover{

transform:translateY(-5px);

  }/*================ RESPONSIVE ================*/

@media (max-width:1100px){

.hero-grid{

grid-template-columns:1fr;

text-align:center;

}

.hero-text p{

margin:auto auto 35px;

}

.hero-btns{

justify-content:center;

}

.features .container{

grid-template-columns:repeat(2,1fr);

}

.category-grid{

grid-template-columns:repeat(2,1fr);

}

.product-grid{

grid-template-columns:repeat(2,1fr);

}

.review-grid{

grid-template-columns:1fr;

}

.why-grid{

grid-template-columns:repeat(2,1fr);

}

.footer-grid{

grid-template-columns:repeat(2,1fr);

}

}

@media (max-width:768px){

.header .container{

flex-direction:column;

gap:18px;

}

.search-box{

width:100%;

max-width:100%;

}

.navbar .container{

gap:18px;

}

.hero{

padding:70px 0;

}

.hero-text h1{

font-size:42px;

}

.hero-text p{

font-size:16px;

}

.hero-image img{

width:300px;

}

.features .container,

.category-grid,

.product-grid,

.why-grid,

.footer-grid{

grid-template-columns:1fr;

}

.section-header h2{

font-size:34px;

}

.whatsapp-section h2{

font-size:32px;

}

.product-card img{

height:240px;

}

.copyright{

flex-direction:column;

text-align:center;

}

}

@media (max-width:480px){

.logo{

width:60px;

height:60px;

}

.brand h2{

font-size:22px;

}

.navbar a{

font-size:14px;

}

.hero-text h1{

font-size:34px;

}

.btn{

width:100%;

}

.hero-btns{

flex-direction:column;

}

.product-content h3{

font-size:20px;

}

.price{

font-size:24px;

}

.product-buttons button,

.product-buttons a{

height:46px;

font-size:14px;

}

#scrollTop{

width:46px;

height:46px;

font-size:18px;

right:15px;

bottom:15px;

}

}

/*================ SELECTION ================*/

::selection{

background:#d4af37;

color:#000;

}

/*================ SCROLLBAR ================*/

::-webkit-scrollbar{

width:10px;

}

::-webkit-scrollbar-track{

background:#111;

}

::-webkit-scrollbar-thumb{

background:#d4af37;

border-radius:20px;

}

::-webkit-scrollbar-thumb:hover{

background:#f5d66a;

}
